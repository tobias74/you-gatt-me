<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.YouGattMe" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/simulator_moss</item>
        <item name="colorPrimaryVariant">@color/simulator_moss_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/simulator_amber</item>
        <item name="colorSecondaryVariant">@color/simulator_rust</item>
        <item name="colorOnSecondary">@color/simulator_ink</item>
        <item name="android:fontFamily">sans</item>
        <item name="fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/simulator_canvas</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/simulator_canvas</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.YouGattMe.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.YouGattMe.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.YouGattMe.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>
