<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootConsole"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/simulator_background"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="96dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/simulator_panel"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/simulator_line"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.08"
                    android:text="RUNTIME"
                    android:textAllCaps="true"
                    android:textColor="@color/simulator_moss"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bluetooth"
                            android:textColor="@color/simulator_ink_muted"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/textBluetoothState"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Checking"
                            android:textColor="@color/simulator_ink"
                            android:textSize="19sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GATT server"
                            android:textColor="@color/simulator_ink_muted"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/textServerState"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Idle"
                            android:textColor="@color/simulator_ink"
                            android:textSize="19sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchGattServer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:padding="12dp"
                    android:text="GATT server enabled"
                    android:textColor="@color/simulator_ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressRuntimeUpdating"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@color/simulator_amber"
                    app:trackColor="@color/simulator_line" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonBluetoothSettings"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Open Bluetooth settings"
                    android:textAllCaps="false"
                    android:textColor="@color/simulator_moss_dark" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="serif"
            android:text="Profiles"
            android:textColor="@color/simulator_ink"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textFeatureBitExplanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tap a profile to edit it. Use the row switch to toggle the active GATT stack."
            android:textColor="@color/simulator_ink_muted"
            android:textSize="14sp" />

        <ExpandableListView
            android:id="@+id/listServiceProfiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:cacheColorHint="@android:color/transparent"
            android:choiceMode="none"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"
            android:groupIndicator="@null"
            android:nestedScrollingEnabled="false" />

        <LinearLayout
            android:id="@+id/layoutProfileContentStaging"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/layoutFtmsLiveData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.08"
                    android:text="REMOTE CONTROL STATE"
                    android:textAllCaps="true"
                    android:textColor="@color/simulator_moss"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:padding="0dp">

                    <TextView
                        android:id="@+id/textDeviceStateTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Workout idle"
                        android:textColor="@color/simulator_ink"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textDeviceStateSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Control Point is available. No client owns the machine yet."
                        android:textColor="@color/simulator_ink_muted"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-condensed"
                                android:letterSpacing="0.08"
                                android:text="CONTROL"
                                android:textAllCaps="true"
                                android:textColor="@color/simulator_moss"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/textControlPointState"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Available"
                                android:textColor="@color/simulator_ink"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-condensed"
                                android:letterSpacing="0.08"
                                android:text="WORKOUT"
                                android:textAllCaps="true"
                                android:textColor="@color/simulator_moss"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/textWorkoutState"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Idle"
                                android:textColor="@color/simulator_ink"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-condensed"
                                android:letterSpacing="0.08"
                                android:text="TRAINING"
                                android:textAllCaps="true"
                                android:textColor="@color/simulator_moss"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/textTrainingStatusState"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Idle"
                                android:textColor="@color/simulator_ink"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-condensed"
                                android:letterSpacing="0.08"
                                android:text="MACHINE"
                                android:textAllCaps="true"
                                android:textColor="@color/simulator_moss"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/textMachineModeState"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Indoor Bike"
                                android:textColor="@color/simulator_ink"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textProcedureState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="monospace"
                        android:text="Targets: none"
                        android:textColor="@color/simulator_ink_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/textControlProcedureState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="monospace"
                        android:text="Control procedure: idle"
                        android:textColor="@color/simulator_ink_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:background="@color/simulator_line" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.08"
                    android:text="FTMS DEVICE TYPE"
                    android:textAllCaps="true"
                    android:textColor="@color/simulator_moss"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerFtmsMachine"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:background="@color/simulator_line" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.08"
                    android:text="FTMS MEASUREMENT DATA"
                    android:textAllCaps="true"
                    android:textColor="@color/simulator_moss"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Values emitted in the selected FTMS machine data characteristic. Control Point targets are tracked separately in the status area."
                    android:textColor="@color/simulator_ink_muted"
                    android:textSize="13sp" />

                <TextView android:id="@+id/labelSpeedValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Speed 25.0 km/h" android:textColor="@color/simulator_ink" android:textSize="16sp" android:textStyle="bold" />
                <com.google.android.material.slider.Slider android:id="@+id/sliderSpeed" android:layout_width="match_parent" android:layout_height="wrap_content" android:value="25" android:valueFrom="0" android:valueTo="60" android:stepSize="0.5" />

                <TextView android:id="@+id/labelCadenceValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Cadence 80 rpm" android:textColor="@color/simulator_ink" android:textSize="16sp" android:textStyle="bold" />
                <com.google.android.material.slider.Slider android:id="@+id/sliderCadence" android:layout_width="match_parent" android:layout_height="wrap_content" android:value="80" android:valueFrom="0" android:valueTo="180" android:stepSize="1" />

                <TextView android:id="@+id/labelPowerValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Power 150 W" android:textColor="@color/simulator_ink" android:textSize="16sp" android:textStyle="bold" />
                <com.google.android.material.slider.Slider android:id="@+id/sliderPower" android:layout_width="match_parent" android:layout_height="wrap_content" android:value="150" android:valueFrom="0" android:valueTo="1000" android:stepSize="5" />

                <LinearLayout
                    android:id="@+id/layoutFtmsMeasurementResistance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView android:id="@+id/labelResistanceValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Current resistance 20" android:textColor="@color/simulator_ink" android:textSize="16sp" android:textStyle="bold" />
                    <com.google.android.material.slider.Slider android:id="@+id/sliderResistance" android:layout_width="match_parent" android:layout_height="wrap_content" android:value="20" android:valueFrom="0" android:valueTo="25" android:stepSize="1" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutFtmsMeasurementInclination"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView android:id="@+id/labelInclinationValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Inclination 0.0%" android:textColor="@color/simulator_ink" android:textSize="16sp" android:textStyle="bold" />
                    <com.google.android.material.slider.Slider android:id="@+id/sliderInclination" android:layout_width="match_parent" android:layout_height="wrap_content" android:value="0" android:valueFrom="-20" android:valueTo="20" android:stepSize="0.5" />
                </LinearLayout>

                <TextView android:id="@+id/labelHeartRateValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Heart rate 120 bpm" android:textColor="@color/simulator_ink" android:textSize="16sp" android:textStyle="bold" />
                <com.google.android.material.slider.Slider android:id="@+id/sliderHeartRate" android:layout_width="match_parent" android:layout_height="wrap_content" android:value="120" android:valueFrom="40" android:valueTo="220" android:stepSize="1" />

                <TextView android:id="@+id/labelMetabolicEquivalentValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="MET 8.0" android:textColor="@color/simulator_ink" android:textSize="16sp" android:textStyle="bold" />
                <com.google.android.material.slider.Slider android:id="@+id/sliderMetabolicEquivalent" android:layout_width="match_parent" android:layout_height="wrap_content" android:value="8" android:valueFrom="0" android:valueTo="25" android:stepSize="0.1" />

                <TextView android:id="@+id/labelTargetDurationValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Session duration / remaining-time basis 30 min" android:textColor="@color/simulator_ink" android:textSize="16sp" android:textStyle="bold" />
                <com.google.android.material.slider.Slider android:id="@+id/sliderTargetDuration" android:layout_width="match_parent" android:layout_height="wrap_content" android:value="30" android:valueFrom="0" android:valueTo="240" android:stepSize="1" />

                <LinearLayout
                    android:id="@+id/layoutIndoorBikeSimulationParameters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="18dp"
                        android:background="@color/simulator_line" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.08"
                        android:text="REMOTE CONTROL — BIKE SIMULATION TARGET"
                        android:textAllCaps="true"
                        android:textColor="@color/simulator_moss"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Read-only Control Point state. These values arrive from a client and are echoed through Fitness Machine Status; they are never measurement inputs."
                        android:textColor="@color/simulator_ink_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/textIndoorBikeSimulationState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="monospace"
                        android:text="No bike simulation target received"
                        android:textColor="@color/simulator_ink"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textIndoorBikeComputed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:text="Avg 0.0 km/h | 0 m | 0 s | 0 kcal"
                    android:textColor="@color/simulator_ink_muted"
                    android:textSize="13sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:background="@color/simulator_line" />

                <TextView
                    android:id="@+id/textFtmsMeasurementPacketTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.08"
                    android:text="MEASUREMENT PACKET PREVIEW"
                    android:textAllCaps="true"
                    android:textColor="@color/simulator_moss"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textFtmsMeasurementPackets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:text="Waiting for the first FTMS measurement record…"
                    android:textColor="@color/simulator_ink_muted"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:background="@color/simulator_line" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.08"
                    android:text="FTMS PROTOCOL EVENTS"
                    android:textAllCaps="true"
                    android:textColor="@color/simulator_moss"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textFtmsProtocolEvents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:text="No Control Point, Fitness Machine Status, or Training Status traffic yet."
                    android:textColor="@color/simulator_ink_muted"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonClearFtmsEvents"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="4dp"
                    android:text="Clear events" />

                <LinearLayout
                    android:id="@+id/layoutFtmsControlCapability"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="18dp"
                        android:background="@color/simulator_line" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.08"
                        android:text="PROTOCOL CONFIGURATION — CONTROL POINT"
                        android:textAllCaps="true"
                        android:textColor="@color/simulator_moss"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchFtmsControlPoint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:checked="true"
                        android:text="Control Point characteristic enabled"
                        android:textColor="@color/simulator_ink" />

                    <LinearLayout
                        android:id="@+id/layoutControlCapabilityToggleList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutMachineFieldControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="18dp"
                        android:background="@color/simulator_line" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.08"
                        android:text="PROTOCOL CONFIGURATION — MEASUREMENT FIELDS"
                        android:textAllCaps="true"
                        android:textColor="@color/simulator_moss"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchHeartRate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:checked="true"
                        android:text="Feature/data: Heart Rate"
                        android:textColor="@color/simulator_ink" />

                    <LinearLayout
                        android:id="@+id/layoutMachineFieldToggleList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/layoutCscLiveData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.08"
                    android:text="CSC SERVICE VALUES"
                    android:textAllCaps="true"
                    android:textColor="@color/simulator_moss"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView android:id="@+id/labelCscSpeedValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="CSC speed 25.0 km/h" android:textColor="@color/simulator_ink" android:textSize="16sp" android:textStyle="bold" />
                <com.google.android.material.slider.Slider android:id="@+id/sliderCscSpeed" android:layout_width="match_parent" android:layout_height="wrap_content" android:value="25" android:valueFrom="0" android:valueTo="60" android:stepSize="0.5" />

                <TextView android:id="@+id/labelCscCadenceValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="CSC cadence 80 rpm" android:textColor="@color/simulator_ink" android:textSize="16sp" android:textStyle="bold" />
                <com.google.android.material.slider.Slider android:id="@+id/sliderCscCadence" android:layout_width="match_parent" android:layout_height="wrap_content" android:value="80" android:valueFrom="0" android:valueTo="180" android:stepSize="1" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp" android:layout_marginBottom="14dp" android:background="@color/simulator_line" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif-condensed" android:letterSpacing="0.08" android:text="MEASUREMENT NOTIFICATIONS" android:textAllCaps="true" android:textColor="@color/simulator_moss" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/textCscMeasurementPreview" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="monospace" android:text="Waiting for CSC Measurement…" android:textColor="@color/simulator_ink_muted" android:textIsSelectable="true" android:textSize="12sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:fontFamily="sans-serif-condensed" android:letterSpacing="0.08" android:text="CONTROL POINT EVENTS" android:textAllCaps="true" android:textColor="@color/simulator_moss" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/textCscProtocolEvents" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="monospace" android:text="No CSC Control Point traffic yet." android:textColor="@color/simulator_ink_muted" android:textIsSelectable="true" android:textSize="12sp" />
                <LinearLayout android:id="@+id/layoutCscProtocolControls" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutCyclingPowerLiveData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.08"
                    android:text="CYCLING POWER SERVICE VALUES"
                    android:textAllCaps="true"
                    android:textColor="@color/simulator_moss"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView android:id="@+id/labelCyclingPowerValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Cycling Power 152 W" android:textColor="@color/simulator_ink" android:textSize="16sp" android:textStyle="bold" />
                <com.google.android.material.slider.Slider android:id="@+id/sliderCyclingPower" android:layout_width="match_parent" android:layout_height="wrap_content" android:value="152" android:valueFrom="0" android:valueTo="1000" android:stepSize="1" />

                <TextView android:id="@+id/labelCyclingPowerSpeedValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Cycling Power wheel speed 25.0 km/h" android:textColor="@color/simulator_ink" android:textSize="16sp" android:textStyle="bold" />
                <com.google.android.material.slider.Slider android:id="@+id/sliderCyclingPowerSpeed" android:layout_width="match_parent" android:layout_height="wrap_content" android:value="25" android:valueFrom="0" android:valueTo="60" android:stepSize="0.5" />

                <TextView android:id="@+id/labelCyclingPowerCadenceValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Cycling Power cadence 80 rpm" android:textColor="@color/simulator_ink" android:textSize="16sp" android:textStyle="bold" />
                <com.google.android.material.slider.Slider android:id="@+id/sliderCyclingPowerCadence" android:layout_width="match_parent" android:layout_height="wrap_content" android:value="80" android:valueFrom="0" android:valueTo="180" android:stepSize="1" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp" android:layout_marginBottom="14dp" android:background="@color/simulator_line" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif-condensed" android:letterSpacing="0.08" android:text="MEASUREMENT &amp; VECTOR NOTIFICATIONS" android:textAllCaps="true" android:textColor="@color/simulator_moss" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/textCyclingPowerMeasurementPreview" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="monospace" android:text="Waiting for Cycling Power Measurement…" android:textColor="@color/simulator_ink_muted" android:textIsSelectable="true" android:textSize="12sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:fontFamily="sans-serif-condensed" android:letterSpacing="0.08" android:text="CONTROL POINT EVENTS" android:textAllCaps="true" android:textColor="@color/simulator_moss" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/textCyclingPowerProtocolEvents" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="monospace" android:text="No Cycling Power Control Point traffic yet." android:textColor="@color/simulator_ink_muted" android:textIsSelectable="true" android:textSize="12sp" />
                <LinearLayout android:id="@+id/layoutCyclingPowerProtocolControls" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutRscLiveData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.08"
                    android:text="RSC SERVICE VALUES"
                    android:textAllCaps="true"
                    android:textColor="@color/simulator_moss"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView android:id="@+id/labelRscSpeedValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="RSC speed 2.8 m/s" android:textColor="@color/simulator_ink" android:textSize="16sp" android:textStyle="bold" />
                <com.google.android.material.slider.Slider android:id="@+id/sliderRscSpeed" android:layout_width="match_parent" android:layout_height="wrap_content" android:value="2.8" android:valueFrom="0" android:valueTo="10" android:stepSize="0.1" />

                <TextView android:id="@+id/labelRscCadenceValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="RSC cadence 80 spm" android:textColor="@color/simulator_ink" android:textSize="16sp" android:textStyle="bold" />
                <com.google.android.material.slider.Slider android:id="@+id/sliderRscCadence" android:layout_width="match_parent" android:layout_height="wrap_content" android:value="80" android:valueFrom="0" android:valueTo="220" android:stepSize="1" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp" android:layout_marginBottom="14dp" android:background="@color/simulator_line" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif-condensed" android:letterSpacing="0.08" android:text="MEASUREMENT NOTIFICATIONS" android:textAllCaps="true" android:textColor="@color/simulator_moss" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/textRscMeasurementPreview" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="monospace" android:text="Waiting for RSC Measurement…" android:textColor="@color/simulator_ink_muted" android:textIsSelectable="true" android:textSize="12sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:fontFamily="sans-serif-condensed" android:letterSpacing="0.08" android:text="CONTROL POINT EVENTS" android:textAllCaps="true" android:textColor="@color/simulator_moss" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/textRscProtocolEvents" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="monospace" android:text="No RSC Control Point traffic yet." android:textColor="@color/simulator_ink_muted" android:textIsSelectable="true" android:textSize="12sp" />
                <LinearLayout android:id="@+id/layoutRscProtocolControls" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.08"
            android:text="EVENT LOG"
            android:textAllCaps="true"
            android:textColor="@color/simulator_moss_dark"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textEventLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/simulator_log_panel"
            android:fontFamily="monospace"
            android:minHeight="150dp"
            android:padding="16dp"
            android:text="Ready."
            android:textColor="#D8E8C7"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
