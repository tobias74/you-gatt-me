<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootConsole"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/simulator_background"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="96dp">

        <TextView
            android:id="@+id/textEyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/simulator_status_pill"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.14"
            android:text="OPEN GATT LAB"
            android:textAllCaps="true"
            android:textColor="@color/simulator_lime"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="serif"
            android:lineSpacingExtra="-4dp"
            android:text="Simulator Console"
            android:textColor="@color/simulator_ink"
            android:textSize="44sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Build, activate, and inspect Bluetooth GATT profile simulations from one control surface."
            android:textColor="@color/simulator_ink_muted"
            android:textSize="16sp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRuntime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            app:cardBackgroundColor="@color/simulator_panel"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/simulator_line"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.08"
                    android:text="RUNTIME"
                    android:textAllCaps="true"
                    android:textColor="@color/simulator_moss"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bluetooth"
                            android:textColor="@color/simulator_ink_muted"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/textBluetoothState"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Checking"
                            android:textColor="@color/simulator_ink"
                            android:textSize="19sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GATT server"
                            android:textColor="@color/simulator_ink_muted"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/textServerState"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Idle"
                            android:textColor="@color/simulator_ink"
                            android:textSize="19sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchGattServer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:padding="12dp"
                    android:text="GATT server enabled"
                    android:textColor="@color/simulator_ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressRuntimeUpdating"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@color/simulator_amber"
                    app:trackColor="@color/simulator_line" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonBluetoothSettings"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Open Bluetooth settings"
                    android:textAllCaps="false"
                    android:textColor="@color/simulator_moss_dark" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardProfiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@color/simulator_panel"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/simulator_line"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.08"
                    android:text="PROFILE CATALOG"
                    android:textAllCaps="true"
                    android:textColor="@color/simulator_moss"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Build a service stack. Pick one FTMS equipment type, then layer optional standard services on top."
                    android:textColor="@color/simulator_ink_muted"
                    android:textSize="14sp" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:columnCount="2"
                    android:rowCount="5">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonFtmsBike"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="FTMS Bike"
                        android:textAllCaps="false"
                        android:textColor="@color/simulator_ink"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/simulator_line" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonFtmsRower"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="FTMS Rower"
                        android:textAllCaps="false"
                        android:textColor="@color/simulator_ink"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/simulator_line" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonFtmsTreadmill"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="FTMS Treadmill"
                        android:textAllCaps="false"
                        android:textColor="@color/simulator_ink"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/simulator_line" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonFtmsCrossTrainer"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="FTMS Cross"
                        android:textAllCaps="false"
                        android:textColor="@color/simulator_ink"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/simulator_line" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonFtmsStepClimber"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="FTMS Step"
                        android:textAllCaps="false"
                        android:textColor="@color/simulator_ink"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/simulator_line" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonFtmsStairClimber"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="FTMS Stair"
                        android:textAllCaps="false"
                        android:textColor="@color/simulator_ink"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/simulator_line" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonCsc"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="CSC"
                        android:textAllCaps="false"
                        android:textColor="@color/simulator_ink"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/simulator_line" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonCyclingPower"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="Cycling Power"
                        android:textAllCaps="false"
                        android:textColor="@color/simulator_ink"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/simulator_line" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonRsc"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="RSC"
                        android:textAllCaps="false"
                        android:textColor="@color/simulator_ink"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/simulator_line" />

                </GridLayout>

                <LinearLayout
                    android:id="@+id/layoutExtensionProfileSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.08"
                        android:text="EXTENSIONS"
                        android:textAllCaps="true"
                        android:textColor="@color/simulator_moss"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Locally attached provider modules can add simulator profiles here without changing the public app."
                        android:textColor="@color/simulator_ink_muted"
                        android:textSize="14sp" />

                    <GridLayout
                        android:id="@+id/gridExtensionProfiles"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:columnCount="2" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@color/simulator_panel_alt"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/simulator_line"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.08"
                    android:text="LIVE DATA"
                    android:textAllCaps="true"
                    android:textColor="@color/simulator_moss"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textFeatureBitExplanation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Sliders drive emitted measurement values. Feature/data switches below control fields sent in FTMS measurement packets and their matching read-only measurement feature bits."
                    android:textColor="@color/simulator_ink_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/labelSpeedValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Speed 25.0 km/h"
                    android:textColor="@color/simulator_ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:value="25"
                    android:valueFrom="0"
                    android:valueTo="60"
                    android:stepSize="0.5" />

                <LinearLayout
                    android:id="@+id/layoutSpeedFieldToggles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/labelCadenceValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Cadence 80 rpm"
                    android:textColor="@color/simulator_ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderCadence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:value="80"
                    android:valueFrom="0"
                    android:valueTo="180"
                    android:stepSize="1" />

                <LinearLayout
                    android:id="@+id/layoutCadenceFieldToggles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/labelPowerValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Power 180 W"
                    android:textColor="@color/simulator_ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderPower"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:value="180"
                    android:valueFrom="0"
                    android:valueTo="1000"
                    android:stepSize="5" />

                <LinearLayout
                    android:id="@+id/layoutPowerFieldToggles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/labelResistanceValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Resistance 20"
                    android:textColor="@color/simulator_ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderResistance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:value="20"
                    android:valueFrom="0"
                    android:valueTo="100"
                    android:stepSize="1" />

                <LinearLayout
                    android:id="@+id/layoutResistanceFieldToggles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/labelInclinationValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Inclination 0.0%"
                    android:textColor="@color/simulator_ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderInclination"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:value="0"
                    android:valueFrom="-20"
                    android:valueTo="20"
                    android:stepSize="0.5" />

                <LinearLayout
                    android:id="@+id/layoutInclinationFieldToggles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/labelHeartRateValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Heart rate 120 bpm"
                    android:textColor="@color/simulator_ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderHeartRate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:value="120"
                    android:valueFrom="40"
                    android:valueTo="220"
                    android:stepSize="1" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchHeartRate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:checked="true"
                    android:text="Feature/data: Heart Rate"
                    android:textColor="@color/simulator_ink" />

                <LinearLayout
                    android:id="@+id/layoutHeartRateFieldToggles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/labelMetabolicEquivalentValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Metabolic equivalent 8.0 MET"
                    android:textColor="@color/simulator_ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderMetabolicEquivalent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:value="8"
                    android:valueFrom="0"
                    android:valueTo="25"
                    android:stepSize="0.1" />

                <LinearLayout
                    android:id="@+id/layoutMetabolicFieldToggles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/labelTargetDurationValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Target duration 30 min"
                    android:textColor="@color/simulator_ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderTargetDuration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:value="30"
                    android:valueFrom="1"
                    android:valueTo="240"
                    android:stepSize="1" />

                <LinearLayout
                    android:id="@+id/layoutDurationFieldToggles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/textIndoorBikeComputed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="monospace"
                    android:text="Avg 0.0 km/h | 0 m | 0 s | 0 kcal"
                    android:textColor="@color/simulator_ink_muted"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/layoutFtmsControlCapability"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.08"
                        android:text="CONTROL POINT + READABLE CAPABILITIES"
                        android:textAllCaps="true"
                        android:textColor="@color/simulator_moss"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="These do not change emitted measurement packets. Actual control toggles gate Control Point writes; Declared bit toggles set target-setting bits clients read from Fitness Machine Feature."
                        android:textColor="@color/simulator_ink_muted"
                        android:textSize="13sp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchFtmsControlPoint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:checked="true"
                        android:text="Control Point characteristic enabled"
                        android:textColor="@color/simulator_ink" />

                    <LinearLayout
                        android:id="@+id/layoutControlCapabilityToggleList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutIndoorBikeFieldControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.08"
                        android:text="INDOOR BIKE PACKET FIELDS"
                        android:textAllCaps="true"
                        android:textColor="@color/simulator_moss"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Instantaneous speed is required in normal Indoor Bike Data packets and is always included."
                        android:textColor="@color/simulator_ink_muted"
                        android:textSize="13sp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchBikeAverageSpeed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Average Speed"
                        android:textColor="@color/simulator_ink" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchBikeInstantCadence"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Instantaneous Cadence"
                        android:textColor="@color/simulator_ink" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchBikeAverageCadence"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Average Cadence"
                        android:textColor="@color/simulator_ink" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchBikeTotalDistance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Total Distance"
                        android:textColor="@color/simulator_ink" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchBikeResistance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Resistance Level"
                        android:textColor="@color/simulator_ink" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchBikeInstantPower"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Instantaneous Power"
                        android:textColor="@color/simulator_ink" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchBikeAveragePower"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Average Power"
                        android:textColor="@color/simulator_ink" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchBikeExpendedEnergy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Expended Energy"
                        android:textColor="@color/simulator_ink" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchBikeMetabolicEquivalent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Metabolic Equivalent"
                        android:textColor="@color/simulator_ink" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchBikeElapsedTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Elapsed Time"
                        android:textColor="@color/simulator_ink" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchBikeRemainingTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Remaining Time"
                        android:textColor="@color/simulator_ink" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutMachineFieldControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/textMachineFieldHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.08"
                        android:text="FTMS PACKET FIELDS"
                        android:textAllCaps="true"
                        android:textColor="@color/simulator_moss"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textMachineFieldDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Mandatory base fields are always included in normal FTMS data records."
                        android:textColor="@color/simulator_ink_muted"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/layoutMachineFieldToggleList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDeviceState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@color/simulator_ink"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.08"
                    android:text="DEVICE STATE"
                    android:textAllCaps="true"
                    android:textColor="@color/simulator_lime"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textDeviceStateTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Workout idle"
                    android:textColor="@color/white"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textDeviceStateSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Control Point is available. No client owns the machine yet."
                    android:textColor="#C8D7C2"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-condensed"
                            android:letterSpacing="0.08"
                            android:text="CONTROL POINT"
                            android:textAllCaps="true"
                            android:textColor="@color/simulator_lime"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textControlPointState"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Available"
                            android:textColor="@color/white"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-condensed"
                            android:letterSpacing="0.08"
                            android:text="WORKOUT"
                            android:textAllCaps="true"
                            android:textColor="@color/simulator_lime"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textWorkoutState"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Idle"
                            android:textColor="@color/white"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-condensed"
                            android:letterSpacing="0.08"
                            android:text="TRAINING STATUS"
                            android:textAllCaps="true"
                            android:textColor="@color/simulator_lime"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textTrainingStatusState"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Idle"
                            android:textColor="@color/white"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-condensed"
                            android:letterSpacing="0.08"
                            android:text="MACHINE"
                            android:textAllCaps="true"
                            android:textColor="@color/simulator_lime"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textMachineModeState"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Indoor Bike"
                            android:textColor="@color/white"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/textProcedureState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="monospace"
                    android:text="Procedure: ready"
                    android:textColor="#E8EAD8"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.08"
            android:text="EVENT LOG"
            android:textAllCaps="true"
            android:textColor="@color/simulator_moss_dark"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textEventLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/simulator_log_panel"
            android:fontFamily="monospace"
            android:minHeight="150dp"
            android:padding="16dp"
            android:text="Ready."
            android:textColor="#D8E8C7"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
